# Copie este arquivo para `.env` e preencha com os valores reais.

# Configuração da API do softswitch (NextBilling)
SOFTSWITCH_API_URL=
SOFTSWITCH_API_TOKEN=
SOFTSWITCH_API_KEY=

# Banco de métricas (Postgres, role/database dedicados ao backend)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gs_reposts_metrics

# Scheduler de coleta (janelas 7h-20h de hora em hora + overnight 20h-7h)
SCHEDULER_ENABLED=true
SCHEDULER_SCAN_LIMIT=10000
SCHEDULER_CLIENT_CONCURRENCY=5
SCHEDULER_TIMEZONE=America/Sao_Paulo

# Webhook disparado ao final de cada janela de coleta, pra o frontend atualizar a tela sem
# precisar de reload manual. Deixe em branco pra desligar (o job de coleta funciona sem isso).
# ATENCAO: a porta abaixo so funciona se o frontend realmente subir nela — `npm run dev` (via
# start-dev.ps1) tenta a 3000 por padrao, mas se essa porta ja estiver em uso o Next.js sobe
# automaticamente na proxima livre (3001, 3002...) sem avisar. Confira a porta real no terminal
# do frontend antes de assumir que o webhook vai funcionar.
FRONTEND_WEBHOOK_URL=http://127.0.0.1:3000/api/webhook/metricas-atualizadas
