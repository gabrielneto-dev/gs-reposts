# Copie este arquivo para `.env` e preencha com os valores reais.

# Configuração da API do softswitch (NextBilling)
SOFTSWITCH_API_URL=
SOFTSWITCH_API_TOKEN=
SOFTSWITCH_API_KEY=

# Banco de métricas (Postgres, role/database dedicados ao backend)
DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/gs_reposts_metrics

# Scheduler de coleta (janelas 7h-20h de hora em hora + overnight 20h-7h)
SCHEDULER_ENABLED=true
SCHEDULER_SCAN_LIMIT=10000
SCHEDULER_CLIENT_CONCURRENCY=5
SCHEDULER_TIMEZONE=America/Sao_Paulo
